<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            DoNotAcceptEvents="true">
      <Children>

        <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                      SuggestedWidth="120" SuggestedHeight="36"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      MarginRight="5"
                      IsVisible="@IsMapButtonVisible"
                      Brush="Popup.Done.Button.NineGrid"
                      DoNotPassEventsToChildren="true"
                      Command.Click="ExecuteOpenPanel"
                      UpdateChildrenStates="true">
          <Children>
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Brush="Popup.Button.Text" Brush.FontSize="16" Text="@BrandLabel" />
          </Children>
        </ButtonWidget>

        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                IsVisible="@IsVisible" DoNotAcceptEvents="true">
      <Children>

        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="BlankWhiteSquare_9" Color="#00000066" DoNotAcceptEvents="true" />
        <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                      DoNotPassEventsToChildren="true"
                      Command.Click="ExecuteClose" />

        <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                   SuggestedWidth="900" SuggestedHeight="680"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   StackLayout.LayoutMethod="VerticalTopToBottom">
          <Children>

            <BrushWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                         Brush="Frame1Brush">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                           MarginLeft="15" MarginRight="15" MarginTop="15" MarginBottom="15"
                           StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>

                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                               SuggestedHeight="40"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               MarginBottom="10">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Recruitment.Popup.Title.Text" Brush.FontSize="26"
                                    Text="@TitleLabel" />
                      </Children>
                    </ListPanel>

                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                               SuggestedHeight="30"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               MarginBottom="8">
                      <Children>
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="165"
                                    Brush="Popup.Button.Text" Brush.FontSize="16"
                                    Text="@PlayerGold" />
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="165"
                                    Brush="Popup.Button.Text" Brush.FontSize="16"
                                    Text="@CapacityText" />
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="110"
                                    Brush="Popup.Button.Text" Brush.FontSize="16"
                                    Text="@SpeedText" />
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                    SuggestedWidth="200"
                                    Brush="Popup.Button.Text" Brush.FontSize="16"
                                    Brush.FontColor="#FFD700FF"
                                    Text="@LifetimeText" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="14"
                                    HorizontalAlignment="Right"
                                    Text="@StatusText" />
                      </Children>
                    </ListPanel>

                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                               SuggestedHeight="25"
                               StackLayout.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="130" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadItem" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="105" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadBuyTown" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadPrice" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="105" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadSellTown" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadPrice" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadQuantity" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="75" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadProfit" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="60" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadDays" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="60" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadData" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="45" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadCaravans" />
                        <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="45" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadConfidence" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                    Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#FFD700FF" Text="@HeadScore" />
                      </Children>
                    </ListPanel>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="2" MarginBottom="4"
                            Sprite="BlankWhiteSquare_9" Color="#FFD70055" DoNotAcceptEvents="true" />

                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                     SuggestedHeight="300"
                                     AutoHideScrollBars="true"
                                     ClipRect="RouteListContainer\ClipRect"
                                     InnerPanel="RouteListContainer\ClipRect\RouteList"
                                     VerticalScrollbar="RouteListContainer\ScrollbarDimensionSync\Scrollbar">
                      <Children>
                        <ListPanel Id="RouteListContainer" WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren">
                          <Children>
                            <Widget Id="ClipRect" WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="CoverChildren" ClipContents="true" MaxHeight="300">
                              <Children>
                                <ListPanel Id="RouteList" DataSource="{Routes}"
                                           WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                           StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <ButtonWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                                  SuggestedHeight="28" MarginBottom="1"
                                                  Brush="TradeLord.RowHover"
                                                  DoNotPassEventsToChildren="false"
                                                  UpdateChildrenStates="true">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                IsVisible="@IsAlternateRow" Sprite="BlankWhiteSquare_9" Color="#FFFFFF0A" />
                                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                                          <Children>
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="130"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@ItemName" />
                                            <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="105" HeightSizePolicy="StretchToParent"
                                                          DoNotPassEventsToChildren="true" Command.Click="ExecuteClickBuyTown"
                                                          UpdateChildrenStates="true">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#FFD78CFF" Text="@BuyTownName" />
                                              </Children>
                                            </ButtonWidget>
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@BuyPrice" />
                                            <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="105" HeightSizePolicy="StretchToParent"
                                                          DoNotPassEventsToChildren="true" Command.Click="ExecuteClickSellTown"
                                                          UpdateChildrenStates="true">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#FFD78CFF" Text="@SellTownName" />
                                              </Children>
                                            </ButtonWidget>
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@SellPrice" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="55"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@Quantity" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="75"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@Profit" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="60"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@Days" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="60"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="14"
                                                        Brush.FontColor="#BBBBBBFF"
                                                        Text="@DataAge" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="45"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="16"
                                                        Text="@Caravans" />
                                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="45"
                                                        HeightSizePolicy="StretchToParent"
                                                        Brush="Popup.Button.Text" Brush.FontSize="14"
                                                        Brush.FontColor="#BBBBBBFF"
                                                        Text="@Confidence" />
                                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                                              <Children>
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            IsVisible="@Tier1" Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#33D633FF" Text="@Score" />
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            IsVisible="@Tier2" Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#7FD633FF" Text="@Score" />
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            IsVisible="@Tier3" Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#C6D033FF" Text="@Score" />
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            IsVisible="@Tier4" Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#E0B233FF" Text="@Score" />
                                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                                            IsVisible="@Tier5" Brush="Popup.Button.Text" Brush.FontSize="16"
                                                            Brush.FontColor="#E08A33FF" Text="@Score" />
                                              </Children>
                                            </Widget>
                                          </Children>
                                        </ListPanel>
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                            <DimensionSyncWidget Id="ScrollbarDimensionSync" DoNotAcceptEvents="true"
                                                 WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                                                 HorizontalAlignment="Right"
                                                 DimensionToSync="Vertical" WidgetToCopyHeightFrom="..\ClipRect"
                                                 UpdateChildrenStates="true">
                              <Children>
                                <ScrollbarWidget Id="Scrollbar" WidthSizePolicy="Fixed"
                                                 HeightSizePolicy="StretchToParent" SuggestedWidth="8"
                                                 MarginRight="5" AlignmentAxis="Vertical"
                                                 Handle="ScrollHandle" MaxValue="100" MinValue="0"
                                                 IsVisible="false">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                                            SuggestedWidth="4" HorizontalAlignment="Center"
                                            Sprite="BlankWhiteSquare_9" Color="#5a4033FF" AlphaFactor="0.2" />
                                    <ImageWidget Id="ScrollHandle" WidthSizePolicy="Fixed"
                                                 HeightSizePolicy="Fixed" SuggestedHeight="10"
                                                 SuggestedWidth="8" HorizontalAlignment="Center"
                                                 Brush="FaceGen.Scrollbar.Handle" />
                                  </Children>
                                </ScrollbarWidget>
                              </Children>
                            </DimensionSyncWidget>
                          </Children>
                        </ListPanel>
                      </Children>
                    </ScrollablePanel>

                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                SuggestedHeight="16" MarginTop="6"
                                Brush="Popup.Button.Text" Brush.FontSize="11"
                                Brush.FontColor="#AAAAAA88"
                                Text="@LegendText" />

                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                SuggestedHeight="22" MarginTop="8"
                                Brush="Popup.Button.Text" Brush.FontSize="15"
                                Brush.FontColor="#FFD700FF"
                                Text="@WorkshopsHeader" />
                    <ListPanel DataSource="{Workshops}"
                               WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                               SuggestedHeight="110"
                               StackLayout.LayoutMethod="VerticalTopToBottom">
                      <ItemTemplate>
                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                                   SuggestedHeight="22"
                                   StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>
                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="420"
                                        HeightSizePolicy="StretchToParent"
                                        Brush="Popup.Button.Text" Brush.FontSize="15"
                                        Text="@Name" />
                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="90"
                                        HeightSizePolicy="StretchToParent"
                                        Brush="Popup.Button.Text" Brush.FontSize="15"
                                        Brush.FontColor="#7FD633FF"
                                        Text="@Profit" />
                            <TextWidget WidthSizePolicy="StretchToParent"
                                        HeightSizePolicy="StretchToParent"
                                        Brush="Popup.Button.Text" Brush.FontSize="15"
                                        Brush.FontColor="#BBBBBBFF"
                                        Text="@Owner" />
                          </Children>
                        </ListPanel>
                      </ItemTemplate>
                    </ListPanel>

                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed"
                               SuggestedHeight="50" MarginTop="10"
                               StackLayout.LayoutMethod="HorizontalLeftToRight"
                               HorizontalAlignment="Center">
                      <Children>
                        <ButtonWidget DoNotPassEventsToChildren="true"
                                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                      SuggestedWidth="180" SuggestedHeight="45"
                                      MarginRight="15"
                                      Brush="Popup.Done.Button.NineGrid"
                                      Command.Click="ExecuteRefresh"
                                      UpdateChildrenStates="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Brush="Popup.Button.Text" Text="@RefreshLabel" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget DoNotPassEventsToChildren="true"
                                      WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                                      SuggestedWidth="180" SuggestedHeight="45"
                                      Brush="Popup.Done.Button.NineGrid"
                                      Command.Click="ExecuteClose"
                                      UpdateChildrenStates="true">
                          <Children>
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                        Brush="Popup.Button.Text" Text="@CloseLabel" />
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>

                  </Children>
                </ListPanel>
              </Children>
            </BrushWidget>

          </Children>
        </ListPanel>

      </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>
