{
  "permissions": {
    "allow": [
      "Bash(git fetch:*)",
      "Bash(git checkout main)",
      "Bash(git checkout --detach origin/main)",
      "Bash(git reset --hard origin/main)",
      "Bash(git push -u origin HEAD:main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/no-new-branch.sh"
          }
        ]
      }
    ]
  }
}
